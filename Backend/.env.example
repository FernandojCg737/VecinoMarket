DEBUG=True
SECRET_KEY=cambia-esta-clave-en-produccion
DATABASE_URL=postgres://vecinomarket:password@localhost:5432/vecinomarket
ALLOWED_HOSTS=localhost,127.0.0.1

# Solo en Windows, y solo si tu PostgreSQL no está instalado en la ruta por
# defecto (C:\Program Files\PostgreSQL\16) o si tu bundle de PostGIS generó
# DLLs con otro nombre/versión (revisa la carpeta bin de tu instalación).
# PG_BIN_PATH=C:\Program Files\PostgreSQL\16\bin
# GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\16\bin\libgdal-35.dll
# GEOS_LIBRARY_PATH=C:\Program Files\PostgreSQL\16\bin\libgeos_c.dll

# Envío de correos (credenciales de empresa, recuperación de contraseña).
# Preferido: Gmail API por HTTPS (funciona en el plan gratuito de Render,
# que bloquea SMTP saliente) — generar GMAIL_API_REFRESH_TOKEN con
# scripts/generar_refresh_token_gmail.py. Sin estas 3, cae a SMTP normal
# (sirve para correr local); sin nada de esto, al backend de consola (los
# correos se imprimen en la terminal en vez de enviarse).
# GMAIL_API_CLIENT_ID=tu-client-id-tipo-desktop.apps.googleusercontent.com
# GMAIL_API_CLIENT_SECRET=tu-client-secret
# GMAIL_API_REFRESH_TOKEN=el-que-imprime-el-script

# EMAIL_HOST_USER=tu-cuenta@gmail.com
# EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicación-de-gmail
# DEFAULT_FROM_EMAIL=VecinoMarket <tu-cuenta@gmail.com>
FRONTEND_URL=http://localhost:5173

# Login con Google (Google Identity Services) — mismo Client ID que en el frontend.
# GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# CU22: llave de desarrollador para poder ver la bitácora (confidencial
# incluso para el administrador de BD). Sin esto, nadie puede verla.
# DEVELOPER_KEY=una-clave-larga-random

# Cloudinary (CU07): imágenes subidas por el admin/las empresas. Sin esto,
# el storage cae a disco local (no persiste en Render). Cuenta gratis en
# cloudinary.com, las 3 claves están en su Dashboard.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
